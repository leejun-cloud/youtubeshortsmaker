# Required for AI notes, highlight scoring, metadata, and hook thumbnails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# YouTube captions are the first transcription backend for YouTube URLs.
# yt-dlp must be installed separately and available on PATH.
YTDLP_BIN=yt-dlp
TRANSCRIPT_LANGUAGE=ko

# Local Whisper CLI is the fallback backend for local files or missing captions.
# Example command expected on PATH: whisper.
WHISPER_CLI_BIN=whisper
WHISPER_MODEL=medium
WHISPER_LANGUAGE=ko

# Optional fallback transcription providers.
OPENAI_API_KEY=

# YouTube source ingest and future upload.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional stock media for thumbnails/backgrounds.
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Optional AI image generation for thumbnails.
VERTEX_AI_API_KEY=
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_KEY_JSON=

# Optional BGM search/generation.
JAMENDO_CLIENT_ID=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Optional Lyria music generation.
VERTEX_AI_MUSIC_MODEL=lyria-002

# Optional hosting/publishing integrations inherited from iscardnew.
FIREBASE_ADMIN_KEY_JSON=
INSTA_ACCOUNT_ID=
INSTA_ACCESS_TOKEN=
INSTA_API_VERSION=v23.0

# Optional Canva asset access.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_ACCESS_TOKEN=
CANVA_REFRESH_TOKEN=

# Optional topic/news enrichment.
NEWS_API_KEY=

# Optional notifications.
SLACK_SIGNING_SECRET=
